datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  mediaAssets   MediaAsset[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]

  @@map("categories")
}

model Tag {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@map("tags")
}

model Post {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  description      String
  content          String     @db.Text
  coverImage       String?
  authorId         String
  categoryId       String?
  status           PostStatus @default(DRAFT)
  featured         Boolean    @default(false)
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  readingTime      Int        @default(5)
  seoTitle         String?
  seoDescription   String?
  canonicalUrl     String?
  author           User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category         Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             Tag[]
  mediaAssets      MediaAsset[]
  analytics        ArticleAnalytics?

  @@index([status, publishedAt])
  @@index([featured, status])
  @@index([categoryId])
  @@map("posts")
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  altText      String?
  uploadedBy   String
  uploadedAt   DateTime @default(now())
  user         User     @relation(fields: [uploadedBy], references: [id])
  postId       String?
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([uploadedBy])
  @@map("media_assets")
}

model ArticleAnalytics {
  id          String   @id @default(cuid())
  postId      String   @unique
  views       Int      @default(0)
  uniqueViews Int      @default(0)
  lastViewed  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("article_analytics")
}

model Research {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  summary     String
  content     String     @db.Text
  status      PostStatus @default(DRAFT)
  authors     String
  venue       String?
  year        Int?
  doi         String?
  url         String?
  publishedAt DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tags        ResearchTag[]

  @@index([status, publishedAt])
  @@map("research")
}

model ResearchTag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  color     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  research  Research[]

  @@map("research_tags")
}
